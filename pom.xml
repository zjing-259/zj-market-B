<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath />
  </parent>
  <groupId>cn.zj</groupId>
  <artifactId>zj-market</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>zj-market</name>
  <modules>
    <module>zj-market-domain</module>
    <module>zj-market-application</module>
    <module>zj-market-infrastructure</module>
    <module>zj-market-trigger</module>
    <module>zj-market-app</module>
    <module>zj-market-verification</module>
  </modules>
  <properties>
    <java.version>21</java.version>
    <!-- Fixed after actual B TLS comparison; keep the verified SDK combination. -->
    <netty.version>4.1.118.Final</netty.version>
    <dubbo.version>3.2.16</dubbo.version>
    <rocketmq.version>4.9.7</rocketmq.version>
    <a-contract.version>1.0-SNAPSHOT</a-contract.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>cn.zj</groupId>
        <artifactId>zj-market-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.zj</groupId>
        <artifactId>zj-market-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.zj</groupId>
        <artifactId>zj-market-infrastructure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.zj</groupId>
        <artifactId>zj-market-trigger</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.zj</groupId>
        <artifactId>zj-market-app</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.zj</groupId>
        <artifactId>zj-market-verification</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.bugstack</groupId>
        <artifactId>group-buy-market-contract</artifactId>
        <version>${a-contract.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.dubbo</groupId>
        <artifactId>dubbo</artifactId>
        <version>${dubbo.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.rocketmq</groupId>
        <artifactId>rocketmq-client</artifactId>
        <version>${rocketmq.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.rocketmq</groupId>
        <artifactId>rocketmq-acl</artifactId>
        <version>${rocketmq.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>b-requires-jdk21</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>B requires JDK 21. Use scripts/mvn.ps1; keep A on Java 8.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>