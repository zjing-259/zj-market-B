{
  "openapi": "3.1.0",
  "info": {
    "title": "商品待拼团队查询",
    "version": "td-00.1",
    "description": "Contract frozen in TD-00; B endpoint isolated-tested in TD-02 and storefront page browser-tested with mocked HTTP in TD-03, not deployed."
  },
  "x-design-status": "implemented-in-source-isolated-tested-not-deployed",
  "x-process-document": "team-discovery-development.md",
  "servers": [
