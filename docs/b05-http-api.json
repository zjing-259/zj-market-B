    "schemas": {
      "Id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^\\S+$"
      },
      "Version": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$",
        "description": "1..9223372036854775807，服务端须检查上界"
      },
      "Money": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
        "description": "服务端验证大于0并等于原收款全额"
      },
      "Instant": {
        "type": "string",
        "format": "date-time"
      },
      "Reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "FundsStatus": {
        "type": "string",
