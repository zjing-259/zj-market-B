          "NONE",
          "PENDING",
          "UNKNOWN",
          "FAILED",
          "SUCCEEDED"
        ]
      },
      "SyncStatus": {
        "type": "string",
        "enum": [
          "NOT_CREATED",
          "PENDING",
          "ACCEPTED",
          "WAITING_DEPENDENCY",
          "REVIEW_REQUIRED"
        ]
      },
      "ReleaseStatus": {
        "type": "string",
        "enum": [
