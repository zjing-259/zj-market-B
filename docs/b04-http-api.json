{
  "openapi": "3.1.0",
  "info": {
    "title": "B-04支付HTTP增量",
    "version": "b04.6",
    "description": "本人支付及原订单响应增量：.2收银台、.3资金/可靠消息、.4支付开放后关闭、.5可信成团库存确认/PENDING待履约已编码；普通新写默认关闭；.6模拟联合验收通过，退款/完整到期核对归B-05，生产总联调归B-06。B-02/B-03历史契约保持。"
  },
  "x-design-status": "implemented-b04.6",
  "x-process-document": "b04-development.md",
  "x-joint-design-document": "b04-joint-design.md",
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/orders/{orderId}/payment": {
      "get": {
        "operationId": "getOrderPayment",
        "summary": "查看本人订单资金摘要；未创建支付单返回payment=null",
        "responses": {
          "200": {
            "description": "查询或同键返回原受理快照；资金状态以本人查询接口为准。",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                },
                "description": "与响应正文requestId一致。"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPaymentViewResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      },
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        }
      ]
    },
    "/orders/{orderId}/payment-attempts": {
      "post": {
        "operationId": "createPaymentAttempt",
        "summary": "受理首次/失败后新尝试；未知只恢复原尝试",
        "responses": {
          "200": {
            "description": "同键原受理快照或已完成同事实观察；不产生新渠道动作。",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                },
                "description": "与响应正文requestId一致。"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationReceiptResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          },
          "202": {
            "description": "已持久受理，不表示渠道成功/A已接受/已成团。",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                },
                "description": "与响应正文requestId一致。"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationReceiptResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAttemptRequest"
              },
              "examples": {
                "first": {
                  "value": {
                    "operationId": "b041-create-1",
                    "previousAttemptId": null
                  }
                },
                "retryAfterConfirmedFailure": {
                  "value": {
                    "operationId": "b041-create-2",
                    "previousAttemptId": "b041-attempt-1"
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        }
      ]
    },
    "/orders/{orderId}/payment-operations/{operationId}": {
      "get": {
        "operationId": "getPaymentOperation",
        "summary": "查询本人原受理快照及当前处理进度",
        "responses": {
          "200": {
            "description": "查询或同键返回原受理快照；资金状态以本人查询接口为准。",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                },
                "description": "与响应正文requestId一致。"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationViewResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      },
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        },
        {
          "name": "operationId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        }
      ]
    },
    "/payments/{paymentId}": {
      "get": {
        "operationId": "getPayment",
        "summary": "查询本人稳定商城支付单",
        "responses": {
          "200": {
            "description": "查询或同键返回原受理快照；资金状态以本人查询接口为准。",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                },
                "description": "与响应正文requestId一致。"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentViewResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      },
      "parameters": [
        {
          "name": "paymentId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        }
      ]
    },
    "/payments/{paymentId}/attempts/{attemptId}": {
      "get": {
        "operationId": "getPaymentAttempt",
        "summary": "查询本人原渠道尝试的商城观察结果",
        "responses": {
          "200": {
            "description": "查询或同键返回原受理快照；资金状态以本人查询接口为准。",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                },
                "description": "与响应正文requestId一致。"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptViewResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      },
      "parameters": [
        {
          "name": "paymentId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        },
        {
          "name": "attemptId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        }
      ]
    },
    "/payments/{paymentId}/attempts/{attemptId}/simulated-results": {
      "post": {
        "operationId": "chooseSimulatedPaymentResult",
        "summary": "受理本人有效尝试的模拟成功/失败选择",
        "responses": {
          "200": {
            "description": "同键原受理快照或已完成同事实观察；不产生新渠道动作。",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                },
                "description": "与响应正文requestId一致。"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationReceiptResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          },
          "202": {
            "description": "已持久受理，不表示渠道成功/A已接受/已成团。",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                },
                "description": "与响应正文requestId一致。"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationReceiptResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChooseResultRequest"
              },
              "examples": {
                "success": {
                  "value": {
                    "operationId": "b041-result-1",
                    "result": "SUCCEEDED"
                  }
                },
                "failure": {
                  "value": {
                    "operationId": "b041-result-2",
                    "result": "FAILED"
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "paymentId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        },
        {
          "name": "attemptId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "Version": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,18}$",
        "description": "正long十进制字符串，服务端另校验不超过9223372036854775807。"
      },
      "Money": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,5})\\.[0-9]{2}$",
        "description": "CNY精确两位，另校验0.01～999999.99。"
      },
      "UtcMillis": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
      },
      "Currency": {
        "type": "string",
        "const": "CNY"
      },
      "FundsState": {
        "type": "string",
        "enum": [
          "UNPAID",
          "UNKNOWN",
          "SUCCEEDED"
        ]
      },
      "PaymentGate": {
        "type": "string",
        "enum": [
          "OPEN",
          "CLOSING",
          "CLOSED_UNPAID",
          "PAID"
        ]
      },
      "AttemptState": {
        "type": "string",
        "enum": [
          "CREATING",
          "OPEN",
          "UNKNOWN",
          "FAILED",
          "SUCCEEDED",
          "CLOSED_UNPAID"
        ]
      },
      "AAcceptance": {
        "type": "string",
        "enum": [
          "NOT_SENT",
          "PENDING",
          "ACCEPTED",
          "REJECTED",
          "REVIEW_REQUIRED"
        ]
      },
      "ResultChoice": {
        "type": "string",
        "enum": [
          "SUCCEEDED",
          "FAILED"
        ]
      },
      "CreateAttemptRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "previousAttemptId"
        ],
        "properties": {
          "operationId": {
            "$ref": "#/components/schemas/Id"
          },
          "previousAttemptId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Id"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ChooseResultRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "result"
        ],
        "properties": {
          "operationId": {
            "$ref": "#/components/schemas/Id"
          },
          "result": {
            "$ref": "#/components/schemas/ResultChoice"
          }
        }
      },
      "OperationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "action",
          "orderId",
          "paymentId",
          "attemptId",
          "accepted",
          "receivedAt",
          "errorCode"
        ],
        "properties": {
          "operationId": {
            "$ref": "#/components/schemas/Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "CREATE_ATTEMPT",
              "CHOOSE_RESULT"
            ]
          },
          "orderId": {
            "$ref": "#/components/schemas/Id"
          },
          "paymentId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "attemptId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted": {
            "type": "boolean"
          },
          "receivedAt": {
            "$ref": "#/components/schemas/UtcMillis"
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AttemptView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "paymentId",
          "attemptId",
          "attemptNo",
          "version",
          "state",
          "amount",
          "currency",
          "paymentDeadline",
          "paidAt",
          "channelTransactionId",
          "canSelectResult",
          "errorCode"
        ],
        "properties": {
          "orderId": {
            "$ref": "#/components/schemas/Id"
          },
          "paymentId": {
            "$ref": "#/components/schemas/Id"
          },
          "attemptId": {
            "$ref": "#/components/schemas/Id"
          },
          "attemptNo": {
            "$ref": "#/components/schemas/Version"
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          },
          "state": {
            "$ref": "#/components/schemas/AttemptState"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "paymentDeadline": {
            "$ref": "#/components/schemas/UtcMillis"
          },
          "paidAt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UtcMillis"
              },
              {
                "type": "null"
              }
            ]
          },
          "channelTransactionId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "canSelectResult": {
            "type": "boolean"
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PaymentView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paymentId",
          "orderId",
          "version",
          "simulated",
          "fundsState",
          "gate",
          "aAcceptance",
          "amount",
          "currency",
          "paymentDeadline",
          "paidAt",
          "activeAttemptId",
          "successAttemptId",
          "attempts",
          "allowedActions",
          "reviewRequired",
          "errorCode"
        ],
        "properties": {
          "paymentId": {
            "$ref": "#/components/schemas/Id"
          },
          "orderId": {
            "$ref": "#/components/schemas/Id"
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          },
          "simulated": {
            "const": true,
            "type": "boolean"
          },
          "fundsState": {
            "$ref": "#/components/schemas/FundsState"
          },
          "gate": {
            "$ref": "#/components/schemas/PaymentGate"
          },
          "aAcceptance": {
            "$ref": "#/components/schemas/AAcceptance"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "paymentDeadline": {
            "$ref": "#/components/schemas/UtcMillis"
          },
          "paidAt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UtcMillis"
              },
              {
                "type": "null"
              }
            ]
          },
          "activeAttemptId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "successAttemptId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttemptView"
            },
            "maxItems": 20,
            "description": "最近20条尝试概要，不是全部渠道关闭证明；active/success指针独立保留。"
          },
          "allowedActions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "CREATE_ATTEMPT",
                "SELECT_RESULT",
                "CANCEL"
              ]
            }
          },
          "reviewRequired": {
            "type": "boolean"
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OrderPaymentView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "payment",
          "canCreateAttempt",
          "simulated",
          "notice"
        ],
        "properties": {
          "orderId": {
            "$ref": "#/components/schemas/Id"
          },
          "payment": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PaymentView"
              },
              {
                "type": "null"
              }
            ]
          },
          "canCreateAttempt": {
            "type": "boolean"
          },
          "simulated": {
            "const": true,
            "type": "boolean"
          },
          "notice": {
            "type": "string",
            "const": "模拟支付，不产生真实扣款"
          }
        }
      },
      "OperationView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt",
          "progress",
          "attempt"
        ],
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/OperationReceipt"
          },
          "progress": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPLIED",
              "REJECTED",
              "WAITING_DEPENDENCY",
              "REVIEW_REQUIRED"
            ]
          },
          "attempt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AttemptView"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "data",
          "requestId"
